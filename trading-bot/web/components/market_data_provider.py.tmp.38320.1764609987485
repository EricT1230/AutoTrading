@st.cache_data(ttl=UPDATE_INTERVALS['multiple'])
def get_multiple_tickers_data(symbols: List[str]) -> Dict[str, Dict]:
    """獲取多個交易對行情（有快取）"""
    async def fetch_data():
        provider = MarketDataProvider()
