class LiveDataComponent:
    """實時數據組件"""
    
    @staticmethod
    def render_live_ticker(symbol: str, placeholder=None):
        """渲染實時行情組件"""
        if placeholder is None:
            placeholder = st.empty()
        
        with placeholder.container():
            # 嘗試獲取實時數據
            ticker_data = get_live_ticker_data(symbol)
            
            if ticker_data:
                col1, col2, col3, col4 = st.columns(4)
                
                with col1:
                    price = ticker_data['last_price']
                    change = ticker_data['change_24h']
                    delta_color = "normal" if change >= 0 else "inverse"
                    st.metric(
                        "最新價格",
                        f"${price:,.2f}",
                        f"{change:+.2f}%",
                        delta_color=delta_color
                    )
                
                with col2:
                    volume = ticker_data['volume_24h']
                    st.metric(
                        "24h 成交量",
                        f"{volume:,.0f}",
                        help="24小時成交量"
                    )
                
                with col3:
                    bid = ticker_data['bid']
                    st.metric(
                        "買價",
                        f"${bid:,.2f}",
                        help="最佳買價"
                    )
                
                with col4:
                    ask = ticker_data['ask']
                    st.metric(
                        "賣價",
                        f"${ask:,.2f}",
                        help="最佳賣價"
                    )
                    
                # 顯示更新時間
                update_time = datetime.fromtimestamp(ticker_data['timestamp'] / 1000)
                st.caption(f"數據更新時間: {update_time.strftime('%H:%M:%S')}")
                
            else:
                with st.container():
                    st.warning(f"⚠️ 無法獲取 {symbol} 的實時數據，請檢查網路連接")
    
    @staticmethod
    def render_ticker_tape(symbols: List[str] = None):
        """渲染行情跑馬燈"""
        if symbols is None:
            symbols = ['BTC/USDT', 'ETH/USDT', 'SOL/USDT', 'ADA/USDT']
        
        st.subheader("📊 實時行情")
        
        # 獲取多個交易對數據
        tickers_data = get_multiple_tickers_data(symbols)
        
        if tickers_data:
            cols = st.columns(len(symbols))
            
            for i, symbol in enumerate(symbols):
                if symbol in tickers_data:
                    ticker = tickers_data[symbol]
                    with cols[i]:
                        price = ticker['last_price']
                        change = ticker['change_24h']
                        color = "🟢" if change >= 0 else "🔴"
                        
                        st.metric(
                            f"{color} {symbol.replace('/', '')}",
                            f"${price:,.2f}",
                            f"{change:+.2f}%"
                        )
                else:
                    with cols[i]:
                        st.metric(f"❓ {symbol.replace('/', '')}", "Loading...", "...")
        else:
            st.info("正在載入市場數據...")


