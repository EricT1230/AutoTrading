class RealtimeDataManager:
    """實時數據管理器 - 使用WebSocket"""
    
    def __init__(self):
        self.ws_url = "wss://ws.okx.com:8443/ws/v5/public"
        self.subscribed_symbols = set()
        self.latest_data = {}
        self.ws_connection = None
        self.running = False
        
    async def subscribe_ticker(self, symbols: List[str]):
        """訂閱實時行情"""
        channels = []
        for symbol in symbols:
            okx_symbol = symbol.replace('/', '-')
            channels.append({
                "channel": "tickers",
                "instId": okx_symbol
            })
        
        subscribe_msg = {
            "op": "subscribe",
            "args": channels
        }
        
        if self.ws_connection:
            await self.ws_connection.send(json.dumps(subscribe_msg))
            
    async def start_websocket(self):
        """啟動WebSocket連接"""
        if self.running:
            return
            
        try:
            self.running = True
            async with websockets.connect(self.ws_url) as websocket:
                self.ws_connection = websocket
                logger.info("WebSocket connected to OKX")
                
                # 訂閱主要交易對
                await self.subscribe_ticker(['BTC/USDT', 'ETH/USDT', 'SOL/USDT', 'ADA/USDT'])
                
                async for message in websocket:
                    data = json.loads(message)
                    if data.get('arg', {}).get('channel') == 'tickers':
                        self.process_ticker_data(data)
                        
        except Exception as e:
            logger.error(f"WebSocket error: {e}")
        finally:
            self.running = False
            
    def process_ticker_data(self, data):
        """處理WebSocket收到的行情數據"""
        if 'data' in data:
            for ticker_data in data['data']:
                symbol = ticker_data.get('instId', '').replace('-', '/')
                
                if symbol:
                    last_price = float(ticker_data.get('last', 0))
                    open_24h = float(ticker_data.get('open24h', last_price))
                    change_24h = ((last_price - open_24h) / open_24h * 100) if open_24h > 0 else 0
                    
                    self.latest_data[symbol] = {
                        'symbol': symbol,
                        'last_price': last_price,
                        'bid': float(ticker_data.get('bidPx', 0)),
                        'ask': float(ticker_data.get('askPx', 0)),
                        'high_24h': float(ticker_data.get('high24h', 0)),
                        'low_24h': float(ticker_data.get('low24h', 0)),
                        'volume_24h': float(ticker_data.get('vol24h', 0)),
                        'change_24h': change_24h,
                        'timestamp': int(ticker_data.get('ts', time.time() * 1000))
                    }
                    
    def get_latest_ticker(self, symbol: str) -> Optional[Dict]:
        """獲取最新的行情數據"""
        return self.latest_data.get(symbol)


class MarketDataProvider:
    """市場數據提供者"""
    
    def __init__(self):
        self.base_urls = {
            'okx': 'https://www.okx.com/api/v5',
            'binance': 'https://api.binance.com/api/v3',
            'coinbase': 'https://api.exchange.coinbase.com',
            'coingecko': 'https://api.coingecko.com/api/v3'
        }
        self.session = None
        
    async def get_session(self):
        """獲取 aiohttp session"""
        if self.session is None:
            self.session = aiohttp.ClientSession()
        return self.session
    
    async def close_session(self):
        """關閉 session"""
        if self.session:
            await self.session.close()
            self.session = None
    
    async def fetch_okx_ticker(self, symbol: str = "BTC-USDT") -> Optional[Dict]:
        """獲取 OKX 行情數據"""
        try:
            session = await self.get_session()
            url = f"{self.base_urls['okx']}/market/ticker"
            params = {"instId": symbol}
            
            async with session.get(url, params=params) as response:
                if response.status == 200:
                    data = await response.json()
                    if data.get('code') == '0' and data.get('data'):
                        ticker_data = data['data'][0]
                        # 計算24小時變化率
                        last_price = float(ticker_data.get('last', 0))
                        open_24h = float(ticker_data.get('open24h', last_price))
                        change_24h = ((last_price - open_24h) / open_24h * 100) if open_24h > 0 else 0
                        
                        return {
                            'symbol': symbol,
                            'last_price': last_price,
                            'bid': float(ticker_data.get('bidPx', 0)),
                            'ask': float(ticker_data.get('askPx', 0)),
                            'high_24h': float(ticker_data.get('high24h', 0)),
                            'low_24h': float(ticker_data.get('low24h', 0)),
                            'volume_24h': float(ticker_data.get('vol24h', 0)),
                            'change_24h': change_24h,
                            'timestamp': int(ticker_data.get('ts', time.time() * 1000))
                        }
                        
        except Exception as e:
            logger.error(f"Error fetching OKX ticker for {symbol}: {e}")
            return None
    
    async def fetch_okx_klines(self, symbol: str = "BTC-USDT", 
                              timeframe: str = "5m", limit: int = 100) -> Optional[pd.DataFrame]:
        """獲取 OKX K線數據"""
        try:
            session = await self.get_session()
            url = f"{self.base_urls['okx']}/market/candles"
            
            # OKX 時間框架映射
            tf_map = {
                '1m': '1m', '3m': '3m', '5m': '5m', '15m': '15m',
                '30m': '30m', '1h': '1H', '2h': '2H', '4h': '4H',
                '6h': '6H', '12h': '12H', '1d': '1D', '1w': '1W'
            }
            
            params = {
                "instId": symbol,
                "bar": tf_map.get(timeframe, '5m'),
                "limit": str(limit)
            }
            
            async with session.get(url, params=params) as response:
                if response.status == 200:
                    data = await response.json()
                    if data.get('code') == '0' and data.get('data'):
                        klines = data['data']
                        
                        # 轉換為 DataFrame
                        df_data = []
                        for kline in klines:
                            df_data.append({
                                'timestamp': pd.to_datetime(int(kline[0]), unit='ms'),
                                'open': float(kline[1]),
                                'high': float(kline[2]),
                                'low': float(kline[3]),
                                'close': float(kline[4]),
                                'volume': float(kline[5])
                            })
                        
                        df = pd.DataFrame(df_data)
                        df.set_index('timestamp', inplace=True)
                        df = df.sort_index()  # 確保時間順序
                        
                        logger.info(f"Fetched {len(df)} klines for {symbol} {timeframe}")
                        return df
                        
        except Exception as e:
            logger.error(f"Error fetching OKX klines for {symbol}: {e}")
            return None
    
    async def fetch_binance_ticker(self, symbol: str = "BTCUSDT") -> Optional[Dict]:
        """獲取 Binance 行情數據（備用數據源）"""
        try:
            session = await self.get_session()
            url = f"{self.base_urls['binance']}/ticker/24hr"
            params = {"symbol": symbol}
            
            async with session.get(url, params=params) as response:
                if response.status == 200:
                    data = await response.json()
                    return {
                        'symbol': symbol,
                        'last_price': float(data.get('lastPrice', 0)),
                        'bid': float(data.get('bidPrice', 0)),
                        'ask': float(data.get('askPrice', 0)),
                        'high_24h': float(data.get('highPrice', 0)),
                        'low_24h': float(data.get('lowPrice', 0)),
                        'volume_24h': float(data.get('volume', 0)),
                        'change_24h': float(data.get('priceChangePercent', 0)),
                        'timestamp': int(time.time() * 1000)
                    }
                    
        except Exception as e:
            logger.error(f"Error fetching Binance ticker for {symbol}: {e}")
            return None
    
    async def fetch_multiple_tickers(self, symbols: List[str]) -> Dict[str, Dict]:
        """批量獲取多個交易對行情"""
        tasks = []
        for symbol in symbols:
            # 優先使用 OKX，失敗時使用 Binance 作為備用
            okx_symbol = symbol.replace('/', '-')
            binance_symbol = symbol.replace('/', '')
            
            tasks.append(self._fetch_ticker_with_fallback(okx_symbol, binance_symbol))
        
        results = await asyncio.gather(*tasks, return_exceptions=True)
        
        ticker_data = {}
        for i, result in enumerate(results):
            if not isinstance(result, Exception) and result:
                ticker_data[symbols[i]] = result
        
        return ticker_data
    
    async def _fetch_ticker_with_fallback(self, okx_symbol: str, binance_symbol: str) -> Optional[Dict]:
        """獲取行情數據，帶備用數據源"""
        # 嘗試 OKX
        ticker = await self.fetch_okx_ticker(okx_symbol)
        if ticker:
            return ticker
        
        # 備用 Binance
        logger.warning(f"OKX failed for {okx_symbol}, trying Binance {binance_symbol}")
        ticker = await self.fetch_binance_ticker(binance_symbol)
        if ticker:
            ticker['symbol'] = okx_symbol  # 統一符號格式
        return ticker
    
    def get_popular_symbols(self) -> List[str]:
        """獲取熱門交易對列表"""
        return [
            'BTC/USDT', 'ETH/USDT', 'BNB/USDT', 'SOL/USDT',
            'ADA/USDT', 'XRP/USDT', 'DOT/USDT', 'AVAX/USDT',
            'MATIC/USDT', 'LINK/USDT', 'UNI/USDT', 'LTC/USDT'
        ]


# 可配置的更新頻率設定 - 超高頻交易需要
UPDATE_INTERVALS = {
    'ticker': 0.5,   # 行情數據：0.5秒更新 (超快)
    'kline': 5,      # K線數據：5秒更新
    'multiple': 1    # 多交易對：1秒更新 (極快)
}

# Streamlit 快取裝飾器版本的數據獲取函數
@st.cache_data(ttl=UPDATE_INTERVALS['ticker'])
def get_live_ticker_data(symbol: str) -> Optional[Dict]:
    """獲取實時行情數據（有快取）"""
    async def fetch_data():
        provider = MarketDataProvider()
        try:
            okx_symbol = symbol.replace('/', '-')
            data = await provider.fetch_okx_ticker(okx_symbol)
            return data
        finally:
            await provider.close_session()
    
    # 在 Streamlit 中運行異步函數
    try:
        loop = asyncio.new_event_loop()
        asyncio.set_event_loop(loop)
        result = loop.run_until_complete(fetch_data())
        loop.close()
        return result
    except Exception as e:
        logger.error(f"Error in get_live_ticker_data: {e}")
        return None

