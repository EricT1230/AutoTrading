"""
實時刷新組件
使用現代方法實現真正的每秒數據刷新
"""

import streamlit as st
import time
import asyncio
from typing import Optional

class RealtimeRefresher:
    """實時刷新管理器"""
    
    def __init__(self, refresh_interval: float = 1.0):
        self.refresh_interval = refresh_interval
        self.last_refresh = 0
        
    def should_refresh(self) -> bool:
        """檢查是否需要刷新"""
        current_time = time.time()
        if current_time - self.last_refresh >= self.refresh_interval:
            self.last_refresh = current_time
            return True
        return False
    
    def get_remaining_time(self) -> float:
        """獲取下次刷新倒計時"""
        current_time = time.time()
        elapsed = current_time - self.last_refresh
        return max(0, self.refresh_interval - elapsed)

def auto_refresh_container(key: str = "auto_refresh", interval: float = 1.0):
    """
    創建自動刷新容器
    
    Args:
        key: 唯一標識符
        interval: 刷新間隔（秒）
    """
    
    # 初始化刷新器
    if f"refresher_{key}" not in st.session_state:
        st.session_state[f"refresher_{key}"] = RealtimeRefresher(interval)
    
    refresher = st.session_state[f"refresher_{key}"]
    
    # 檢查是否啟用自動刷新
    if st.session_state.get('auto_refresh_enabled', False):
        if refresher.should_refresh():
            # 清除快取並重新運行
            st.cache_data.clear()
            st.rerun()
        
        # 顯示倒計時
        remaining = refresher.get_remaining_time()
        
        # 使用 empty 容器定時觸發重新運行
        if remaining > 0:
            placeholder = st.empty()
            with placeholder.container():
                st.markdown(f"""
                <div style='text-align: center; color: #00ff88; font-size: 12px; margin: 5px 0;'>
                    ⏱️ {remaining:.1f}s 後自動刷新
                </div>
                """, unsafe_allow_html=True)
            
            # 短暫延遲後重新運行（模擬實時更新）
            time.sleep(0.1)
            st.rerun()

def force_refresh_button(label: str = "🔄 強制刷新", key: str = "force_refresh"):
    """創建強制刷新按鈕"""
    if st.button(label, key=key, type="primary"):
        # 清除所有快取
        st.cache_data.clear()
        st.cache_resource.clear()
        
        # 重置刷新器狀態
        for session_key in list(st.session_state.keys()):
            if session_key.startswith("refresher_"):
                del st.session_state[session_key]
        
        # 強制重新運行
        st.rerun()
        return True
    return False

def realtime_status_indicator():
    """實時狀態指示器"""
    auto_refresh = st.session_state.get('auto_refresh_enabled', False)
    
    if auto_refresh:
        status_color = "#00ff88"
        status_text = "🟢 實時更新已啟用"
        icon = "🔄"
    else:
        status_color = "#ff6b6b"
        status_text = "🔴 實時更新已停用"
        icon = "⏸️"
    
    st.markdown(f"""
    <div style='
        background: linear-gradient(90deg, {status_color}22, {status_color}11);
        border: 1px solid {status_color}44;
        border-radius: 8px;
        padding: 8px 12px;
        margin: 5px 0;
        text-align: center;
        color: {status_color};
        font-weight: bold;
        font-size: 13px;
    '>
        {icon} {status_text}
    </div>
    """, unsafe_allow_html=True)

def enhanced_auto_refresh_setup():
    """增強版自動刷新設置"""
    
    # 檢查是否啟用自動刷新
    if st.session_state.get('auto_refresh_enabled', False):
        
        # 初始化狀態
        if 'enhanced_refresh_count' not in st.session_state:
            st.session_state.enhanced_refresh_count = 0
        if 'enhanced_last_refresh' not in st.session_state:
            st.session_state.enhanced_last_refresh = time.time()
        
        current_time = time.time()
        elapsed = current_time - st.session_state.enhanced_last_refresh
        
        # 每1秒刷新一次
        if elapsed >= 1.0:
            st.session_state.enhanced_refresh_count += 1
            st.session_state.enhanced_last_refresh = current_time
            
            # 清除數據快取
            st.cache_data.clear()
            
            # 重新運行
            st.rerun()
        
        # 計算剩餘時間
        remaining = max(0, 1.0 - elapsed)
        
        return {
            'active': True,
            'count': st.session_state.enhanced_refresh_count,
            'remaining': remaining,
            'status': f"🔄 實時刷新中 (第{st.session_state.enhanced_refresh_count}次) - {remaining:.1f}s"
        }
    
    return {
        'active': False,
        'count': 0,
        'remaining': 0,
        'status': "⏸️ 自動刷新已停用"
    }